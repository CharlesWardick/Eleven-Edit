{
  "name": "eleven-edit",
  "version": "1.0.0",
  "description": "Eleven Edit — Patch navigation, TFX capture and controls for Avid Eleven Rack (Java bridge transport)",
  "author": "Charles Wardick <charles.wardick@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.wardick.rigrollerplus",
    "productName": "Eleven Edit",
    "asarUnpack": [
      "audio-helper.js",
      "node_modules/audify/**",
      "node_modules/node-gyp-build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "EULA.txt",
      "include": "installer/check-java.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "audio-helper.js",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      "ElevenRackBridge.jar",
      "LICENSE",
      "NOTICE",
      "UserManual.txt"
    ]
  },
  "dependencies": {
    "audify": "^1.10.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.7"
  }
}
